<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="QuickCommands.App.App"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="QcContentBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="QcSidebarBrush" Color="#F4F5F7" />
          <SolidColorBrush x:Key="QcEditorBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="QcBorderBrush" Color="#DDE0E5" />
          <SolidColorBrush x:Key="QcMutedText" Color="#5E6570" />
          <SolidColorBrush x:Key="QcErrorText" Color="#A4262C" />
          <SolidColorBrush x:Key="QcErrorBackground" Color="#FDE7E9" />
          <SolidColorBrush x:Key="QcWarningText" Color="#7A4A00" />
          <SolidColorBrush x:Key="QcWarningBackground" Color="#FFF4CE" />
          <SolidColorBrush x:Key="QcSuccessText" Color="#0F7B0F" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="QcContentBackground" Color="#202329" />
          <SolidColorBrush x:Key="QcSidebarBrush" Color="#191B20" />
          <SolidColorBrush x:Key="QcEditorBackground" Color="#17191D" />
          <SolidColorBrush x:Key="QcBorderBrush" Color="#33373F" />
          <SolidColorBrush x:Key="QcMutedText" Color="#9AA1AC" />
          <SolidColorBrush x:Key="QcErrorText" Color="#FF99A4" />
          <SolidColorBrush x:Key="QcErrorBackground" Color="#442726" />
          <SolidColorBrush x:Key="QcWarningText" Color="#FCE100" />
          <SolidColorBrush x:Key="QcWarningBackground" Color="#433519" />
          <SolidColorBrush x:Key="QcSuccessText" Color="#6CCB5F" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <FontFamily x:Key="QcMonoFont">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource QcContentBackground}" />
    </Style>

    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Foreground" Value="{DynamicResource QcMutedText}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource QcMutedText}" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{DynamicResource QcErrorText}" />
    </Style>

    <Style Selector="ListBox.commands ListBoxItem">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="0,1" />
    </Style>

    <!-- Shell badge (ps / cmd / sh) -->
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="#5B6270" />
    </Style>
    <Style Selector="Border.badge.ps">
      <Setter Property="Background" Value="#2F5DA8" />
    </Style>
    <Style Selector="Border.badge.sh">
      <Setter Property="Background" Value="#2E7D4F" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontFamily" Value="{StaticResource QcMonoFont}" />
    </Style>

    <!-- Warning / error message box -->
    <Style Selector="Border.conflict">
      <Setter Property="Background" Value="{DynamicResource QcWarningBackground}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Border.conflict > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource QcWarningText}" />
    </Style>
    <Style Selector="Border.conflict.error">
      <Setter Property="Background" Value="{DynamicResource QcErrorBackground}" />
    </Style>
    <Style Selector="Border.conflict.error > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource QcErrorText}" />
    </Style>

    <!-- Read-only code preview -->
    <Style Selector="Border.code">
      <Setter Property="Background" Value="{DynamicResource QcEditorBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QcBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Border.code TextBlock, Border.code SelectableTextBlock">
      <Setter Property="FontFamily" Value="{StaticResource QcMonoFont}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Application.Styles>
</Application>
