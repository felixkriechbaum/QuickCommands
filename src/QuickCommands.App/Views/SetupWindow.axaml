<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QuickCommands.App.ViewModels"
        xmlns:r="using:QuickCommands.App.Resources"
        x:Class="QuickCommands.App.Views.SetupWindow"
        x:DataType="vm:ShellSetupViewModel"
        Title="{x:Static r:Strings.Setup_Title}"
        Icon="/Assets/icon.ico"
        Width="640" Height="520" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,20">
      <TextBlock Classes="muted" FontSize="12" Text="{Binding StepText}" />
      <TextBlock Classes="heading" Text="{x:Static r:Strings.Setup_Title}" />
    </StackPanel>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto,8,Auto" Margin="0,20,0,0">
      <Button Content="{x:Static r:Strings.Action_Cancel}" Click="OnCancel" />
      <Button Grid.Column="2" Content="{x:Static r:Strings.Action_Back}" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" />
      <Button Grid.Column="4" Classes="accent" MinWidth="112" HorizontalContentAlignment="Center"
              Content="{Binding NextLabel}" Click="OnNext" />
    </Grid>

    <Panel>
      <!-- Step 1: shells -->
      <StackPanel IsVisible="{Binding IsStep1}" Spacing="8">
        <TextBlock Classes="section" Text="{x:Static r:Strings.Setup_Shells_Title}" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static r:Strings.Setup_Shells_Hint}" Margin="0,0,0,8" />
        <ItemsControl ItemsSource="{Binding Shells}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ShellOptionViewModel">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}" />
                <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Step 2: data folder -->
      <StackPanel IsVisible="{Binding IsStep2}" Spacing="8">
        <TextBlock Classes="section" Text="{x:Static r:Strings.Setup_Data_Title}" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static r:Strings.Setup_Data_Hint}" Margin="0,0,0,8" />
        <Grid ColumnDefinitions="*,8,Auto">
          <TextBox Text="{Binding DataDirectory}" />
          <Button Grid.Column="2" Content="{x:Static r:Strings.Action_Browse}" Click="OnBrowse" />
        </Grid>
      </StackPanel>

      <!-- Step 3: summary -->
      <StackPanel IsVisible="{Binding IsStep3}" Spacing="8">
        <TextBlock Classes="section" Text="{x:Static r:Strings.Setup_Summary_Title}" />
        <ItemsControl ItemsSource="{Binding PlannedChanges}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Grid ColumnDefinitions="16,*" Margin="0,4">
                <Ellipse Width="4" Height="4" Fill="{DynamicResource QcMutedText}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,7,0,0" />
                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,8,0,0" Text="{x:Static r:Strings.Setup_Summary_Backup}" />
      </StackPanel>
    </Panel>
  </DockPanel>
</Window>
