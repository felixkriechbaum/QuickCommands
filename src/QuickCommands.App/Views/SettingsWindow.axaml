<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QuickCommands.App.ViewModels"
        xmlns:r="using:QuickCommands.App.Resources"
        x:Class="QuickCommands.App.Views.SettingsWindow"
        x:DataType="vm:ShellSetupViewModel"
        Title="{x:Static r:Strings.Settings_Title}"
        Icon="/Assets/icon.ico"
        Width="640" Height="600" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="28,24">
    <TextBlock DockPanel.Dock="Top" Classes="heading" Text="{x:Static r:Strings.Settings_Title}" Margin="0,0,0,18" />

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto,8,Auto" Margin="0,18,0,0">
      <Button Classes="danger" Content="{x:Static r:Strings.Settings_RemoveAll}" Click="OnRemoveAll" />
      <Button Grid.Column="2" Content="{x:Static r:Strings.Action_Cancel}" Click="OnCancel" />
      <Button Grid.Column="4" Classes="accent" MinWidth="110" HorizontalContentAlignment="Center"
              Content="{x:Static r:Strings.Action_Apply}" Click="OnApply" />
    </Grid>

    <ScrollViewer>
      <StackPanel Spacing="26">
        <StackPanel>
          <TextBlock Classes="section" Text="{x:Static r:Strings.Settings_Shells}" />
          <ItemsControl ItemsSource="{Binding Shells}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ShellOptionViewModel">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}" />
                  <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <CheckBox Margin="0,10,0,0" Content="{x:Static r:Strings.Settings_AutoReload}" IsChecked="{Binding AutoReload}" />
          <TextBlock Classes="muted" FontSize="12" Margin="28,0,0,0" TextWrapping="Wrap" Text="{x:Static r:Strings.Settings_AutoReloadHint}" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="section" Text="{x:Static r:Strings.Settings_Data}" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static r:Strings.Setup_Data_Hint}" Margin="0,0,0,6" />
          <Grid ColumnDefinitions="*,8,Auto">
            <TextBox Text="{Binding DataDirectory}" />
            <Button Grid.Column="2" Content="{x:Static r:Strings.Action_Browse}" Click="OnBrowse" />
          </Grid>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="section" Text="{x:Static r:Strings.Settings_Language}" />
          <ComboBox MinWidth="220" ItemsSource="{Binding UiLanguages}" SelectedItem="{Binding SelectedUiLanguage}" />
          <TextBlock Classes="muted" FontSize="12" Text="{x:Static r:Strings.Settings_LanguageRestart}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
