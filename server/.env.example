# Copy to .env next to compose.example.yml (never commit the real file).
IMAGE_TAG=latest
SERVER_PORT=3005
DB_CONNECTION_STRING=Server=mysql;Port=3306;Database=quickcommands;User=quickcommands;Password=change-me
FIREBASE_PROJECT_ID=your-firebase-project-id
# Firebase UIDs with admin rights, comma separated
ADMIN_UIDS=
LOGGERUI_URL=https://logging.example.com
# Upload token of the loggerui project "quickcommands"
LOGGERUI_TOKEN=
